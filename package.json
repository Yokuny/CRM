{
  "name": "crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm -r exec tsc --noEmit && pnpm biome check . && pnpm vitest run",
    "format": "biome format . --write",
    "evals": "vitest run --project integration evals/",
    "audit:cache": "tsx packages/ai-kit/scripts/auditCacheThreshold.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "@biomejs/biome": "^2.5.11",
    "zod": "^4.5.4",
    "@crm/contracts": "workspace:*",
    "@crm/ai-kit": "workspace:*",
    "@crm/db": "workspace:*",
    "tsx": "^4.19.2"
  }
}
