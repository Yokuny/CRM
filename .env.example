# Ambiente
NODE_ENV=development

# MongoDB — instância standalone (docker-compose.yml), sem replica set
MONGODB_URI=mongodb://localhost:27017/crm

# crm-api
CRM_API_PORT=8080
SESSION_JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# ai-gateway
AI_GATEWAY_PORT=8081
ANTHROPIC_API_KEY=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# 32 bytes em base64 (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Lida também por crm-api (channel.service.ts, T34) — mesma chave em ambos os
# apps (AD-018): crm-api criptografa o accessToken do Channel na criação,
# ai-gateway decifra para enviar via Meta.
CHANNEL_ENC_KEY=5T+tUh33lRrAM/o+0qMmbB6nCAzm7FvLTIGE2k6H/Qs=
OPENAI_API_KEY=

# payments-asaas (AD-012/AD-034)
# 32 bytes em base64, mesmo formato de CHANNEL_ENC_KEY acima — lida por
# crm-api (asaasIntegration.service.ts, criptografa a apiKey do tenant) e por
# ai-gateway (decifra para chamar o Asaas).
ASAAS_ENC_KEY=X3A0g1SEYVRnkKI3K8GoS3okJFtlbX4HsDRdNsv4nXw=
# URL pública do apps/ai-gateway (onde o webhook do Asaas é recebido) — usada
# por crm-api para montar a URL de callback por tenant no registro do
# webhook (asaasIntegration.service.ts): ${ASAAS_WEBHOOK_BASE_URL}/webhooks/asaas/:webhookToken
ASAAS_WEBHOOK_BASE_URL=http://localhost:8081

# scheduling (SCH-21/SCH-37) — origem pública de apps/web, usada por crm-api
# para montar a URL da página pública de confirmação de agendamento:
# ${WEB_BASE_URL}/appointment?token=...
WEB_BASE_URL=http://localhost:5173

# web (Vite só expõe variáveis prefixadas VITE_ ao client.api.ts)
VITE_API_URL=http://localhost:8080

# MailProvider — "log" escreve no log estruturado em vez de enviar (dev/test)
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
